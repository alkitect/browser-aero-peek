{
  "manifest_version": 3,
  "name": "Browser Tab Dock",
  "version": "0.8.0",
  "author": "alkitect",
  "description": "Linux/Ubuntu Dock: browser tab titles, favicons, and cached thumbnails for GNOME Aero-peek-style hover (Brave + Chrome + Opera + Firefox). Author: alkitect.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-tab-dock@alkitect",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms",
    "favicon",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser tab dock"
  }
}
