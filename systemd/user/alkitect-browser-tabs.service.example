[Unit]
Description=Browser Tabs D-Bus host (dock tab peek). Author: alkitect.
Documentation=https://github.com/alkitect/browser-aero-peek
# Logout keeps user@ + default.target; only graphical-session cycles.
# WantedBy=default.target left the host dead after logout/in (2026-09-10).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=%h/.local/bin/browser-tabs-host daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
