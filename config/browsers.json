{
  "browsers": [
    {
      "id": "brave",
      "enabled": true,
      "nm_schema": "chromium",
      "nm_base": "xdg_config",
      "nm_path": "BraveSoftware/Brave-Browser/NativeMessagingHosts",
      "desktop_ids": ["brave-browser.desktop", "brave-browser"],
      "wm_classes": ["brave-browser"]
    },
    {
      "id": "chrome",
      "enabled": true,
      "nm_schema": "chromium",
      "nm_base": "xdg_config",
      "nm_path": "google-chrome/NativeMessagingHosts",
      "desktop_ids": ["google-chrome.desktop", "google-chrome"],
      "wm_classes": ["google-chrome", "Google-chrome"]
    },
    {
      "id": "opera",
      "family": "opera",
      "packaging": "deb",
      "enabled": true,
      "nm_schema": "chromium",
      "nm_base": "xdg_config",
      "nm_path": "opera/NativeMessagingHosts",
      "desktop_ids": ["opera.desktop", "opera", "opera-browser.desktop"],
      "wm_classes": ["opera", "Opera"]
    },
    {
      "id": "opera-flatpak",
      "family": "opera",
      "packaging": "flatpak",
      "enabled": true,
