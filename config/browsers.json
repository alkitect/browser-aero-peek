        "~/.local/bin:ro",
        "~/.local/share/alkitect-browser-tabs:ro"
      ],
      "flatpak_talk_names": ["org.freedesktop.Flatpak"]
    },
    {
      "id": "vivaldi",
      "enabled": true,
      "nm_schema": "chromium",
      "nm_base": "xdg_config",
      "nm_path": "vivaldi/NativeMessagingHosts",
      "desktop_ids": ["vivaldi-stable.desktop", "vivaldi-stable"],
      "wm_classes": ["vivaldi-stable", "Vivaldi-stable"]
    },
    {
      "id": "chromium",
      "family": "chromium",
      "packaging": "snap",
      "enabled": true,
      "nm_schema": "chromium",
