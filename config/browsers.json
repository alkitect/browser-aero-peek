      "nm_base": "xdg_config",
      "nm_path": "mozilla/native-messaging-hosts",
      "desktop_ids": ["firefox.desktop", "firefox"],
      "wm_classes": ["firefox", "Firefox"]
    },
    {
      "id": "tor",
      "enabled": false,
      "nm_schema": "mozilla",
