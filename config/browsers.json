      "desktop_ids": ["chromium_chromium.desktop", "chromium-browser.desktop", "chromium.desktop"],
      "wm_classes": ["chromium", "chromium-browser", "Chromium-browser"]
    },
    {
      "id": "edge",
      "enabled": false,
      "nm_schema": "chromium",
